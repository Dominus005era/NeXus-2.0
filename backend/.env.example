# NEXUS 2.0 Enterprise Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="NEXUS 2.0"

# Optional Cloud Database (PostgreSQL / Neon) - Defaults to SQLite if unset
DATABASE_URL=sqlite:///./storage/nexus_enterprise.db

# Supabase Auth (required for production login)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy JWT secret (only needed if you verify tokens locally)
SUPABASE_JWT_SECRET=

# Supabase Postgres connection string (takes priority over DATABASE_URL)
# Use the pooled connection string from Project Settings -> Database.
SUPABASE_DB_URL=

# Local/test escape hatch: disables auth verification. Keep false in production.
NEXUS_AUTH_DISABLED=false

# Google Drive API key (required for real public-folder ingestion)
GOOGLE_DRIVE_API_KEY=

# Drive ingestion safety limits (optional)
DRIVE_MAX_FILE_SIZE_BYTES=20971520       # 20 MB per file
DRIVE_MAX_TOTAL_SIZE_BYTES=104857600     # 100 MB total per folder
DRIVE_MAX_FILES=200                      # max files scanned per folder
DRIVE_REQUEST_TIMEOUT_SECONDS=30
DRIVE_CACHE_TTL_SECONDS=0                # 0 = no server-side cache

# LLM Provider Keys (Optional: if unset, free-form docs use heuristic extraction)
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
